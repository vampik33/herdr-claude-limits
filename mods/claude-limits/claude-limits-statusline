#!/usr/bin/env python3
"""Put claude-limits-tap in front of Claude Code's statusLine command, or take it out.

Usage:
    claude-limits-statusline wrap     statusLine "X"  ->  "<tap> -- X"
    claude-limits-statusline unwrap   "<tap> -- X"    ->  "X"

Edits ${CLAUDE_CONFIG_DIR:-~/.claude}/settings.json: keeps every other key
(and refreshInterval), saves settings.json.bak-<time> first, never wraps
twice. The tap is the claude-limits-tap next to this script, so run the copy
inside the installed mod folder.
"""
import contextlib
import json
import os
import shlex
import shutil
import sys
import time


def tap_args(cmd):
    """The args after the tap, or None when cmd isn't our tap."""
    try:
        words = shlex.split(cmd or "")
    except ValueError:
        return None
    if words and os.path.basename(words[0]) == "claude-limits-tap":
        return words[1:]
    return None


def replace_first_word(cmd, word):
    """cmd with its first word replaced; the rest stays verbatim, so its shell syntax survives."""
    lexer = shlex.shlex(cmd, posix=True)
    lexer.whitespace_split = True
    lexer.commenters = ""
    lexer.get_token()
    rest = lexer.instream.read()
    # The lexer consumed the one character that ended the first word.
    return word + cmd[len(cmd) - len(rest) - 1 :] if rest else word


def main(argv):
    if argv not in (["wrap"], ["unwrap"]):
        sys.exit(__doc__.strip())
    mode = argv[0]
    tap = os.path.join(os.path.dirname(os.path.abspath(__file__)), "claude-limits-tap")
    config_dir = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    path = os.path.join(config_dir, "settings.json")
    try:
        with open(path, encoding="utf-8") as f:
            settings = json.load(f)
    except FileNotFoundError:
        settings = {}

    line = settings.get("statusLine")
    command = line.get("command") if isinstance(line, dict) else None
    wrapped = tap_args(command)
    if mode == "wrap":
        old_tap = shlex.split(command)[0] if wrapped is not None else None
        if old_tap and (os.path.exists(os.path.expanduser(old_tap)) or shutil.which(old_tap)):
            print(f"statusLine already wrapped: {command}")
            return
        # Claude Code runs the tap directly; a copy made file by file may have lost +x.
        os.chmod(tap, os.stat(tap).st_mode | 0o111)
        if wrapped is not None:
            # Wrapped by a tap that no longer exists (mod moved or reinstalled
            # elsewhere): point the command at this tap, keep the rest.
            line["command"] = replace_first_word(command, shlex.quote(tap))
        elif isinstance(line, dict) and line.get("type", "command") == "command" and command:
            line["command"] = f"{shlex.quote(tap)} -- {shlex.quote(command)}"
        elif line is None:
            settings["statusLine"] = {"type": "command", "command": shlex.quote(tap)}
        else:
            sys.exit(f"unexpected statusLine in {path}: {json.dumps(line)}")
    else:
        if wrapped is None:
            print("statusLine is not wrapped by claude-limits-tap; nothing to restore")
            return
        rest = wrapped[1:] if wrapped[:1] == ["--"] else []
        if not rest:
            del settings["statusLine"]  # the tap was the whole statusLine
        else:
            # Several words: drop the tap and the "--", keep the rest verbatim.
            line["command"] = rest[0] if len(rest) == 1 else replace_first_word(replace_first_word(command, ""), "").lstrip()

    # Write through a symlinked settings.json (dotfiles) so the link survives.
    # The backup stays beside the link, out of the dotfiles repo.
    real = os.path.realpath(path)
    tmp = f"{real}.claude-limits.tmp"
    backup_tmp = f"{path}.claude-limits-backup.{os.getpid()}.tmp"
    try:
        os.makedirs(os.path.dirname(real), exist_ok=True)
        # The rename below would succeed over a read-only file; a link's target stays untouched.
        if os.path.islink(path) and os.path.exists(real) and not os.access(real, os.W_OK):
            raise PermissionError(f"read-only target: {real}")
        # Checked up front: a stale temp file can still be written in a read-only folder.
        if not os.access(os.path.dirname(real), os.W_OK):
            raise PermissionError(f"read-only folder: {os.path.dirname(real)}")
        # The temp file comes first, so a failed write leaves no backup behind.
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2, ensure_ascii=False)
            f.write("\n")
        if os.path.exists(real):
            shutil.copymode(real, tmp)
            backup = f"{path}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
            # Renamed into place once complete, so a .bak-* is never truncated.
            shutil.copy2(real, backup_tmp)
            os.replace(backup_tmp, backup)
            print(f"backup: {backup}")
        os.replace(tmp, real)
    except OSError as err:
        for leftover in (tmp, backup_tmp):
            with contextlib.suppress(OSError):
                os.remove(leftover)
        sys.exit(f"cannot update settings.json: {err}. settings.json was not changed")
    after = settings.get("statusLine", {}).get("command")
    print(f"statusLine.command: {after}" if after else "statusLine removed")


if __name__ == "__main__":
    main(sys.argv[1:])
